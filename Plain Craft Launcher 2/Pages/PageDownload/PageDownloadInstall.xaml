                            <TextBlock x:Name="LabNeoForge" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="1" />
                        </Grid>
                        <Grid x:Name="PanNeoForgeCompare" Height="18" Margin="132,11,80,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <local:MyImage Style="{StaticResource ModifyCompareIcon}" Source="pack://application:,,,/images/Blocks/NeoForge.png" DockPanel.Dock="Left" />
                                <TextBlock x:Name="LabNeoForgeOld" Style="{StaticResource ModifyCompareText}" />
                            </DockPanel>
                            <Path Grid.Column="1" Style="{StaticResource ModifyCompareArrow}" />
                            <DockPanel Grid.Column="2">
                                <local:MyImage Style="{StaticResource ModifyCompareIcon}" Source="pack://application:,,,/images/Blocks/NeoForge.png" DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource ModifyCompareText}" />
                            </DockPanel>
                        </Grid>
