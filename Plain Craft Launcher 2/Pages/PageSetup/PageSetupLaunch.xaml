<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    x:Class="PageSetupLaunch"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            x:Name="PanBack">
        <StackPanel x:Name="PanMain"
                Margin="25,25,25,10">
            <local:MyCard x:Name="CardArgument"
                    Margin="0,0,0,15"
                    Title="{StaticResource LangPageSetupLaunchLaunchOptions}">
                <StackPanel Margin="25,40,25,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="Name"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchLaunchVersionIsolation}"
                                Margin="0,0,25,0"/>
                        <local:MyComboBox x:Name="ComboArgumentIndieV2"
                                local:SettingService.Key="LaunchArgumentIndieV2"
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Grid.Column="1"
                                ToolTip="{StaticResource LangPageSetupLaunchLaunchVersionIsolationToolTip}">
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVersionIsolationClose}"
                                    ToolTip="{StaticResource LangPageSetupLaunchLaunchVersionIsolationCloseToolTip}"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVersionIsolationModOnly}"
                                    ToolTip="{StaticResource LangPageSetupLaunchLaunchVersionIsolationModOnlyToolTip}"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVersionIsolationBetaOnly}"
                                    ToolTip="{StaticResource LangPageSetupLaunchLaunchVersionIsolationBetaOnlyToolTip}"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVersionIsolationBetaAndMod}"
                                                  ToolTip="将可安装 Mod 的版本、Minecraft 快照、预发布版、远古版本、愚人节版本与其他版本进行隔离。"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVersionIsolationAll}"
                                    ToolTip="{StaticResource LangPageSetupLaunchLaunchVersionIsolationAllToolTip}"/>
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchLaunchWindowTitle}"
                                Margin="0,0,25,0"/>
                        <local:MyTextBox x:Name="TextArgumentTitle"
                                local:SettingService.Key="LaunchArgumentTitle"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Grid.Column="1"
                                ToolTip="{StaticResource LangPageSetupLaunchLaunchWindowTitleToolTip}"
                                HintText="{StaticResource LangSetDefault}"
                                MaxLength="100"/>
                        <TextBlock Grid.Row="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchLaunchCustomInfo}"
                                Margin="0,0,25,0"/>
                        <local:MyTextBox x:Name="TextArgumentInfo"
                                local:SettingService.Key="LaunchArgumentInfo"
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Text="PCL"
                                Grid.Column="1"
                                ToolTip="{StaticResource LangPageSetupLaunchLaunchCustomInfoToolTip}">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateExcept>
                                    <local:ValidateExcept.Excepts>
                                        <System:String>"</System:String>
                                        <System:String>“</System:String>
                                        <System:String>”</System:String>
                                    </local:ValidateExcept.Excepts>
                                </local:ValidateExcept>
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <TextBlock VerticalAlignment="Center"
                                Grid.Row="6"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchLaunchVisibility}"
                                Margin="0,0,25,0"/>
                        <local:MyComboBox x:Name="ComboArgumentVisibie"
                                local:SettingService.Key="LaunchArgumentVisible"
                                Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Grid.Column="1">
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchVisibilityCloseOnGameStart}"/>
                            <local:MyComboBoxItem local:SettingService.Value="2"
                                    Content="{StaticResource LangPageSetupLaunchLaunchVisibilityCloseOnGameClose}"/>
                            <local:MyComboBoxItem local:SettingService.Value="3"
                                    Content="{StaticResource LangPageSetupLaunchLaunchVisibilityRestartOnGameClose}"/>
                            <local:MyComboBoxItem local:SettingService.Value="4"
                                    Content="{StaticResource LangPageSetupLaunchLaunchVisibilityMinimizeOnGameStart}"/>
                            <local:MyComboBoxItem local:SettingService.Value="5"
                                    Content="{StaticResource LangPageSetupLaunchLaunchVisibilityKeep}"/>
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center"
                                Grid.Row="8"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchLaunchGamePriority}"
                                Margin="0,0,25,0"/>
                        <local:MyComboBox x:Name="ComboArgumentPriority"
                                local:SettingService.Key="LaunchArgumentPriority"
                                Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Grid.Column="1">
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchGamePriorityHigh}"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchGamePriorityMedium}"/>
                            <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchGamePriorityLow}"/>
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center"
                                   Grid.Row="10"
                                   HorizontalAlignment="Left"
                                   Text="{StaticResource LangPageSetupLaunchLaunchWindowSize}"
                                   Margin="0,0,25,0"/>
                        <Grid x:Name="PanArgumentWindow"
                              Grid.Row="10"
                              Grid.ColumnSpan="2"
                              Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="ComboArgumentWindowType"
                                    local:SettingService.Key="LaunchArgumentWindowType">
                                <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchWindowSizeFullscreen}"/>
                                <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchWindowSizeDefault}"/>
                                <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchWindowSizeSameWithLaunch}"/>
                                <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchWindowSizeCustom}"
                                        ToolTip="{StaticResource LangPageSetupLaunchLaunchWindowSizeCustomToolTip}"/>
                                <local:MyComboBoxItem Content="{StaticResource LangPageSetupLaunchLaunchWindowSizeMaximum}"/>
                            </local:MyComboBox>
                            <local:MyTextBox x:Name="TextArgumentWindowWidth"
                                    local:SettingService.Key="LaunchArgumentWindowWidth"
                                    Padding="0,0,5,0"
                                    Visibility="Collapsed"
                                    Grid.Column="1"
                                    Margin="50,0,0,0"
                                    Width="60"
                                    HorizontalContentAlignment="Center"
                                    Text="854">
                                <local:MyTextBox.ValidateRules>
                                    <local:ValidateInteger Min="1"
                                                           Max="99999"/>
                                </local:MyTextBox.ValidateRules>
                            </local:MyTextBox>
                            <TextBlock x:Name="LabArgumentWindowMiddle"
                                    Visibility="Collapsed"
                                    Grid.Column="2"
                                    Text=" × "
                                    VerticalAlignment="Center"
                                    FontSize="18"/>
                            <local:MyTextBox x:Name="TextArgumentWindowHeight"
                                    local:SettingService.Key="LaunchArgumentWindowHeight"
                                    Padding="0,0,5,0"
                                    Visibility="Collapsed"
                                    Grid.Column="3"
                                    Width="60"
                                    HorizontalContentAlignment="Center"
                                    Text="480"
                                    ToolTip="{StaticResource LangPageSetupLaunchLaunchWindowSizeCustomToolTip}">
                                <local:MyTextBox.ValidateRules>
                                    <local:ValidateInteger Min="1"
                                                           Max="99999"/>
                                </local:MyTextBox.ValidateRules>
                            </local:MyTextBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15"
                    Title="{StaticResource LangPageSetupLaunchLaunchMem}">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:MyRadioBox Text="{StaticResource LangPageSetupLaunchLaunchMemAutoAdjust}"
                                Width="110"
                                Checked="True"
                                x:Name="RadioRamType0"
                                local:SettingService.Key="LaunchRamType"
                                local:SettingService.Value="0"
                                Margin="0,0,20,0"
                                ToolTip="{StaticResource LangPageSetupLaunchLaunchMemAutoAdjustToolTip}"/>
                        <local:MyRadioBox Grid.Row="2"
                                Text="{StaticResource LangPageSetupLaunchLaunchMemCustom}"
                                x:Name="RadioRamType1"
                                local:SettingService.Key="LaunchRamType"
                                local:SettingService.Value="1"
                                Margin="0,0,20,0"/>
                        <local:MySlider Grid.Row="2"
                                Grid.Column="1"
                                IsEnabled="False"
                                x:Name="SliderRamCustom"
                                local:SettingService.Key="LaunchRamCustom"
                                MaxValue="49"
                                Value="13"/>
                        <local:MyCheckBox local:SettingService.Key="LaunchArgumentRam"
                                          Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Text="{StaticResource LangPageSetupLaunchLaunchMemReduceMemBeforeLaunch}"
                                Height="22"
                                x:Name="CheckArgumentRam"
                                          ToolTip="{StaticResource LangPageSetupLaunchLaunchMemReduceMemBeforeLaunchToolTip}"/>
                        <!--<local:MyTextBox Grid.Row="2" Grid.Column="3" Width="100" VerticalAlignment="Center" Margin="30,0,0,0" Text="2048 MB" />-->
                    </Grid>
                    <Grid x:Name="PanRamDisplay"
                          Margin="0,11,2,0"
                          SnapsToDevicePixels="True"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnRamUsed"
                                              Width="4.7*"/>
                            <ColumnDefinition x:Name="ColumnRamGame"
                                              Width="2.5*"/>
                            <ColumnDefinition x:Name="ColumnRamEmpty"
                                              Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="4"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="RectRamUsed"
                                   Grid.Row="1"
                                   StrokeThickness="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="1,0.5"
                                                     StartPoint="0,0.5">
                                    <GradientStop Color="{DynamicResource ColorObject3}"
                                                  Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorObject2}"
                                                  Offset="0.5"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="1"
                                   StrokeThickness="0"
                                   Grid.Column="1"
                                   Fill="{DynamicResource ColorBrush3}"
                                   Opacity="0.5"
                                   x:Name="RectRamGame"/>
                        <Rectangle x:Name="RectRamEmpty"
                                   Grid.Row="1"
                                   StrokeThickness="0"
                                   Grid.Column="2"
                                   Fill="{DynamicResource ColorBrush6}"
                                   Opacity="0.7"/>
                        <TextBlock x:Name="LabRamUsedTitle"
                                   Text="{StaticResource LangPageSetupLaunchLaunchMemUsedMem}"
                                   Grid.ColumnSpan="3"
                                   Opacity="0.7"
                                   TextTrimming="None"
                                   Margin="2,0,0,5"
                                   FontSize="11"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LabRamGameTitle"
                                   Text="{StaticResource LangPageSetupLaunchLaunchMemMemForGame}"
                                   Opacity="0.7"
                                   Grid.ColumnSpan="3"
                                   TextTrimming="None"
                                   Margin="2,0,0,5"
                                   FontSize="11"
                                   HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Grid.ColumnSpan="3"
                                    Margin="2,3,0,0"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="LabRamUsed"
                                       Text="4.7 GB"
                                       FontSize="16"
                                       Foreground="Black"
                                       TextTrimming="None"/>
                            <TextBlock x:Name="LabRamTotal"
                                       Text=" / 7.9 GB"
                                       FontSize="16"
                                       Foreground="Black"
                                       TextTrimming="None"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2"
                                   x:Name="LabRamGame"
                                   Text="2.5 GB"
                                   Grid.ColumnSpan="3"
                                   TextTrimming="None"
                                   Margin="2,3,0,0"
                                   FontSize="16"
                                   Foreground="Black"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardSkin"
                          Margin="0,0,0,15"
                          Title="{StaticResource LangPageSetupLaunchSkin}"
                          CanSwap="True"
                          IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <local:MyHint Text="{StaticResource LangPageSetupLaunchSkinTips}"
                                  Theme="Yellow"
                                  Margin="0,0,0,10"/>
                    <Grid Margin="-1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox Text="{StaticResource LangPageSetupLaunchSkinTypeRandom}"
                                x:Name="RadioSkinType0"
                                Height="22"
                                local:SettingService.Key="LaunchSkinType"
                                local:SettingService.Value="0"
                                Grid.Column="0"
                                ToolTip="{StaticResource LangPageSetupLaunchSkinTypeRandomToolTip}"/>
                        <local:MyRadioBox Text="Steve"
                                x:Name="RadioSkinType1"
                                Height="22"
                                local:SettingService.Key="LaunchSkinType"
                                local:SettingService.Value="1"
                                Grid.Column="1"/>
                        <local:MyRadioBox Text="Alex"
                                x:Name="RadioSkinType2"
                                Height="22"
                                local:SettingService.Key="LaunchSkinType"
                                local:SettingService.Value="2"
                                Grid.Column="2"/>
                        <local:MyRadioBox Text="{StaticResource LangPageSetupLaunchSkinTypeMicrosoft}"
                                x:Name="RadioSkinType3"
                                Height="22"
                                local:SettingService.Key="LaunchSkinType"
                                local:SettingService.Value="3"
                                Grid.Column="3"
                                ToolTip="{StaticResource LangPageSetupLaunchSkinTypeMicrosoftToolTip}"/>
                        <local:MyRadioBox Text="{StaticResource LangPageSetupLaunchSkinTypeCustom}"
                                x:Name="RadioSkinType4"
                                Height="22"
                                local:SettingService.Key="LaunchSkinType"
                                local:SettingService.Value="4"
                                Grid.Column="4"
                                ToolTip="{StaticResource LangPageSetupLaunchSkinTypeCustomToolTip}"/>
                    </Grid>
                    <Grid x:Name="PanSkinID"
                          Margin="0,14,0,2"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="Name"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{StaticResource LangPageSetupLaunchSkinTypeMicrosoftName}"
                                Margin="0,0,25,0"/>
                        <local:MyTextBox x:Name="TextSkinID"
                                local:SettingService.Key="LaunchSkinID"
                                Grid.Column="1"
                                MaxLength="50"/>
                        <Grid Height="35"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="Button"/>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="Button"/>
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnSkinSave"
                                            Text="{StaticResource LangPageSetupLaunchSkinSave}"
                                            MinWidth="140"
                                            Padding="13,0"
                                            Margin="0,0,20,0"
                                            Grid.Row="1"/>
                            <local:MyButton x:Name="BtnSkinCache"
                                            Text="{StaticResource LangRefresh}"
                                            MinWidth="140"
                                            Padding="13,0"
                                            Margin="0,0,20,0"
                                            ToolTip="{StaticResource LangPageSetupLaunchSkinRefreshToolTip}"
                                            Grid.Row="1"
                                            Grid.Column="1"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PanSkinChange"
                          Margin="0,14,0,2"
                          Height="35"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="Button"/>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="Button"/>
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnSkinChange"
                                        Text="{StaticResource LangPageSetupLaunchSkinChange}"
                                        MinWidth="140"
                                        Padding="13,0"
                                        Margin="0,0,20,0"/>
                        <local:MyButton x:Name="BtnSkinDelete"
                                        Text="{StaticResource LangPageSetupLaunchSkinReset}"
                                        MinWidth="140"
                                        Padding="13,0"
                                        Margin="0,0,20,0"
                                        ColorType="Red"
                                        Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15"
                          Title="{StaticResource LangPageSetupLaunchLaunchAdvanceOptions}"
                          IsSwapped="True"
                          CanSwap="True">
                <Grid Margin="25,40,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,0,25,0">
                        <TextBlock Text="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHead}"
                                VerticalAlignment="Center"/>
                        <local:MyIconButton Height="23"
                                Margin="0,1,0,0"
                                x:Name="BtnAdvanceJvmReset"
                                VerticalAlignment="Center"
                                ToolTip="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHeadReset}"
                                ToolTipService.InitialShowDelay="200"
                                Logo="M530 0c287 0 521 229 521 511s-233 511-521 511c-233 0-436-151-500-368a63 63 0 0 1 44-79 65 65 0 0 1 80 43c48 162 200 276 375 276 215 0 390-171 390-383s-174-383-390-383c-103 0-199 39-270 106l21-5a63 63 0 0 1 33 123l-157 42a65 65 0 0 1-90-42l-49-183a65 65 0 1 1 126-33l6 26A524 524 0 0 1 530 0z"
                                LogoScale="0.9"/>
                    </StackPanel>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceJvm"
                            x:Name="TextAdvanceJvm"
                            Grid.ColumnSpan="2"
                            Grid.Column="1"
                                     ToolTip="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHeadTops}"
                            MaxLength="4000"
                                     Height="100"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            Padding="0,5"
                            VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Text="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsJVMTail}"
                            Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceGame"
                            x:Name="TextAdvanceGame"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Grid.Column="1"
                            ToolTip="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsJVMTailTip}"/>
                    <TextBlock Grid.Row="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Text="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsCommandBeforeStart}"
                            Margin="0,0,25,0"/>
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceRun"
                            x:Name="TextAdvanceRun"
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Grid.Column="1"
                            HintText=""
                                     ToolTip="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsCommandBeforeStartTip}"/>
                    <local:MyCheckBox local:SettingService.Key="LaunchAdvanceRunWait"
                            x:Name="CheckAdvanceRunWait"
                            Grid.Row="5"
                            Grid.Column="1"
                            Visibility="Collapsed"
                                      Text="{StaticResource LangPageSetupLaunchLaunchAdvanceOptionsCommandStartWaitForCommand}"
                            Margin="0,8,0,7"/>
                    <StackPanel VerticalAlignment="Center"
                            Grid.Row="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,0,25,0">
                        <TextBlock Text="{StaticResource LangPageSetupLaunchLaunchJava}"
                                VerticalAlignment="Center"/>
                        <local:MyIconButton Height="23"
                                Margin="0,1,0,0"
                                VerticalAlignment="Center"
                                Theme="Black"
                                CanClick="False"
                                            ToolTip="{StaticResource LangPageSetupLaunchLaunchJavaToolTip}"
                                ToolTipService.InitialShowDelay="0"
                                Opacity="0.3"
                                            Logo="M512 1008C238.7 1008 16 785.2 16 512S238.7 16 512 16 1008 238.7 1008 512 785.2 1008 512 1008z m0-896c-220.8 0-400 179.2-400 400s179.2 400 400 400 400-179.2 400-400S732.8 112 512 112z M514.5 638.7c-26.2 0-48-21.7-48-48 0-52.4 32-100.4 81.9-120.9 26.8-11.5 51.2-39.6 44.8-76.8-5.1-27.5-32-51.8-62.7-56.9-26.2-4.4-51.8 2.5-70.4 18.5-16 13.4-24.3 32-24.3 51.2 0 26.2-21.7 48-48 48s-48-21.7-48-48c0-47.3 21.1-92.8 58.2-124.1a182.4 182.4 0 0 1 147.8-39.6c71.0 11.5 129.2 66.5 142.0 133.7 14.0 76.8-27.5 151.6-101.7 183.0-14.0 5.7-23.0 18.5-23.0 32.6 0 26.2-21.7 48-48 48zM514.5 793.6c-15.3 0-30.0-6.4-40.9-16.6-10.8-10.8-16.6-25.6-16.6-40.9s5.7-30.0 16.6-40.9c2.5-2.5 5.7-5.1 8.9-7.0s6.4-3.8 9.6-5.1a57.7 57.7 0 0 1 80 53.1 57.6 57.6 0 0 1-57.6 57.6z"/>
                    </StackPanel>
                    <Grid x:Name="PanAdvanceJava"
                            Grid.ColumnSpan="2"
                            Grid.Row="7"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:MyComboBox x:Name="ComboAdvanceJava"
                                Grid.Column="0">
                            <!--<local:MyComboBoxItem Content="Java 8 (1.8.0_171)，64 位：C:\Program Files (x86)\Common Files\Oracle\Java\javapath\javaw.exe" IsSelected="True" ToolTip="C:\Program Files (x86)\Common Files\Oracle\Java\javapath\javaw.exe" />-->
                        </local:MyComboBox>
                        <TextBlock x:Name="LabAdvanceJava"
                                Grid.Column="0"
                                Margin="8.5,0,21.5,0"
                                IsHitTestVisible="False"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>
                        <local:MyIconButton Margin="5,2,0,2"
